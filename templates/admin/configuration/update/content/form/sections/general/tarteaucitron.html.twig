{% set form = hookable_metadata.context.form %}
{% set service_sections = tarteaucitron_group_services_by_category(form.services) %}
{% set service_enabled = tarteaucitron_service_enabled_map(form.services) %}

<link rel="stylesheet" href="{{ asset('bundles/cyllenedigitalsyliustarteaucitronplugin/admin/tarteaucitron-admin.css') }}">

<div class="row g-3">
    <div class="col-12 col-xl-8">
        {% set tabs = tarteaucitron_init_tabs() %}
        {# Sylius counts the errors on each tab itself (.tab-error); the plugin only opens the first one. #}
        {% set error_tab = null %}
        {% for tab in tabs %}
            {% set tab_fields = tab.id == 'essential' ? [form.enabled, form.consent_lifetime_days] : [] %}
            {% if tab.localized %}
                {% set tab_fields = [form.localized_options] %}
            {% endif %}
            {% for card in tab.cards %}
                {% for option in card.options %}
                    {% set tab_fields = tab_fields|merge([attribute(form, option.key)]) %}
                {% endfor %}
            {% endfor %}
            {% for field in tab_fields %}
                {% if not field.vars.valid %}
                    {% set error_tab = error_tab ?? tab.id %}
                {% endif %}
            {% endfor %}
        {% endfor %}
        {% set active_tab = error_tab ?? tabs|first.id %}
        {% set findings = tarteaucitron_compliance_findings(form) %}
        {% set conflicts = tarteaucitron_option_conflicts(form) %}
        {% set finding_tabs = {} %}
        {% for tab in tabs %}
            {% set count = 0 %}
            {% for card in tab.cards %}
                {% for option in card.options %}
                    {% set count = count + (findings[option.key] is defined ? 1 : 0) %}
                {% endfor %}
            {% endfor %}
            {% if tab.id == 'essential' and findings.consent_lifetime_days is defined %}
                {% set count = count + 1 %}
            {% endif %}
            {% set finding_tabs = finding_tabs|merge({(tab.id): count}) %}
        {% endfor %}

        {% if findings is not empty %}
            <div class="alert alert-warning" role="alert" {{ sylius_test_html_attribute('tarteaucitron-compliance-summary') }}>
                <h4 class="alert-title">{{ 'cyllene_digital_sylius_tarteaucitron.ui.compliance_summary'|trans({'%count%': findings|length}) }}</h4>
                <ul class="mb-0">
                    {% for message in findings %}
                        <li>{{ message|trans }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <div class="card" id="tarteaucitron-init-tabs" data-error-tab="{{ error_tab }}" data-form-id="{{ form.vars.id }}">
            <div class="card-header">
                <ul class="nav nav-tabs card-header-tabs" role="tablist">
                    {% for tab in tabs %}
                        <li class="nav-item" role="presentation">
                            <button
                                class="nav-link{% if tab.id == active_tab %} active{% endif %}"
                                id="tac-tab-{{ tab.id }}"
                                data-bs-toggle="tab"
                                data-bs-target="#tac-pane-{{ tab.id }}"
                                data-tab="{{ tab.id }}"
                                type="button"
                                role="tab"
                                aria-controls="tac-pane-{{ tab.id }}"
                                aria-selected="{{ tab.id == active_tab ? 'true' : 'false' }}"
                            >
                                {{ tab.title|trans }}
                                {% if finding_tabs[tab.id] > 0 %}
                                    <span class="badge text-bg-warning ms-2" title="{{ 'cyllene_digital_sylius_tarteaucitron.ui.tab_has_compliance_findings'|trans }}">{{ finding_tabs[tab.id] }}</span>
                                {% endif %}
                            </button>
                        </li>
                    {% endfor %}
                </ul>
            </div>
            <div class="card-body">
                <div class="tab-content">
                    {% for tab in tabs %}
                        <div
                            class="tab-pane{% if tab.id == active_tab %} active show{% endif %}"
                            id="tac-pane-{{ tab.id }}"
                            role="tabpanel"
                            aria-labelledby="tac-tab-{{ tab.id }}"
                        >
                            {% if tab.id == 'essential' %}
                                {{ form_row(form.enabled, sylius_test_form_attribute('tarteaucitron-enabled')) }}
                            {% endif %}
                            {% for card in tab.cards %}
                                {% if card.title %}
                                    <h3 class="h3{% if not loop.first or tab.id == 'essential' %} mt-4{% endif %} mb-2">{{ card.title|trans }}</h3>
                                {% endif %}
                                {% if card.intro %}
                                    <p class="text-secondary mb-3">{{ card.intro|trans }}</p>
                                {% endif %}
                                {% for option in card.options %}
                                    {% if card.wrap %}
                                        <div class="border rounded p-3{% if not loop.last %} mb-3{% endif %}">
                                    {% endif %}
                                    {{ form_row(attribute(form, option.key)) }}
                                    {% if findings[option.key] is defined %}
                                        <div class="alert alert-warning py-2" role="alert" {{ sylius_test_html_attribute('tarteaucitron-compliance-' ~ option.key) }}>{{ findings[option.key]|trans }}</div>
                                    {% endif %}
                                    {% if conflicts[option.key] is defined %}
                                        <div class="alert alert-info py-2" role="alert" {{ sylius_test_html_attribute('tarteaucitron-conflict-' ~ option.key) }}>{{ conflicts[option.key]|trans }}</div>
                                    {% endif %}
                                    {% if option.relatedConsentMode %}
                                        {% set related = tarteaucitron_trackers_by_consent_mode(option.relatedConsentMode) %}
                                        <p class="form-hint mb-2">
                                            {{ 'cyllene_digital_sylius_tarteaucitron.ui.consent_mode_related_services'|trans }}:
                                            {% for type in related %}
                                                <span class="badge {{ service_enabled[type]|default(false) ? 'text-bg-success' : 'text-bg-secondary' }}">
                                                    {{ tarteaucitron_service_admin_meta(type).label|trans }}
                                                    ·
                                                    {{ service_enabled[type]|default(false)
                                                        ? 'cyllene_digital_sylius_tarteaucitron.ui.service_status_on'|trans
                                                        : 'cyllene_digital_sylius_tarteaucitron.ui.service_status_off'|trans
                                                    }}
                                                </span>
                                            {% endfor %}
                                        </p>
                                        {% if attribute(form, option.key).vars.data %}
                                            {% set alert = tarteaucitron_consent_alert(option.key, service_enabled) %}
                                            {% if alert %}
                                                <div class="alert alert-{{ alert.level }} mb-0" role="alert">
                                                    {{ alert.message|trans }}
                                                </div>
                                            {% endif %}
                                        {% endif %}
                                    {% endif %}
                                    {% if card.wrap %}
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            {% endfor %}
                            {% if tab.localized %}
                                <p class="text-secondary mb-3">{{ 'cyllene_digital_sylius_tarteaucitron.ui.localized_intro'|trans }}</p>
                                {% if form.localized_options.children is empty %}
                                    <div class="alert alert-info mb-0">{{ 'cyllene_digital_sylius_tarteaucitron.ui.localized_no_locale'|trans }}</div>
                                {% endif %}
                                <div class="accordion" id="tarteaucitron-localized-accordion">
                                    {% for locale in form.localized_options %}
                                        {% set collapse_id = 'tac-locale-' ~ locale.vars.name %}
                                        {% set open = loop.first or not locale.vars.valid %}
                                        <div class="accordion-item">
                                            <h3 class="accordion-header">
                                                <button class="accordion-button{% if not open %} collapsed{% endif %}" type="button" data-bs-toggle="collapse" data-bs-target="#{{ collapse_id }}" aria-expanded="{{ open ? 'true' : 'false' }}" aria-controls="{{ collapse_id }}">
                                                    {{ locale.vars.label }}
                                                    <span class="text-secondary ms-2">{{ locale.vars.name }}</span>
                                                </button>
                                            </h3>
                                            <div id="{{ collapse_id }}" class="accordion-collapse collapse{% if open %} show{% endif %}">
                                                <div class="accordion-body">
                                                    {% for field in locale %}
                                                        {{ form_row(field) }}
                                                    {% endfor %}
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                            {% if tab.id == 'essential' %}
                                {{ form_row(form.consent_lifetime_days) }}
                                {% if findings.consent_lifetime_days is defined %}
                                    <div class="alert alert-warning py-2" role="alert" {{ sylius_test_html_attribute('tarteaucitron-compliance-consent_lifetime_days') }}>{{ findings.consent_lifetime_days|trans }}</div>
                                {% endif %}
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-4">
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">{{ 'cyllene_digital_sylius_tarteaucitron.ui.services'|trans }}</h2>
            </div>
            <div class="card-body">
                {% set incomplete_services = [] %}
                {% for section in service_sections %}
                    {% for service in section.services %}
                        {% set service_entity = service.vars.value %}
                        {% set meta = tarteaucitron_service_admin_meta(service_entity.type|default(''), service_entity.enabled|default(false), service_entity.parameters|default({})) %}
                        {% if meta.incomplete %}
                            {% set incomplete_services = incomplete_services|merge([meta.label|trans]) %}
                        {% endif %}
                    {% endfor %}
                {% endfor %}
                {% if incomplete_services is not empty %}
                    <div class="alert alert-warning py-2" role="alert" {{ sylius_test_html_attribute('tarteaucitron-incomplete-services') }}>
                        {{ 'cyllene_digital_sylius_tarteaucitron.ui.services_incomplete_summary'|trans({'%services%': incomplete_services|join(', ')}) }}
                    </div>
                {% endif %}
                <input
                    type="search"
                    class="form-control mb-3"
                    placeholder="{{ 'cyllene_digital_sylius_tarteaucitron.ui.services_search'|trans }}"
                    aria-label="{{ 'cyllene_digital_sylius_tarteaucitron.ui.services_search'|trans }}"
                    data-tac-service-search
                >
                <p class="text-secondary mb-3 d-none" data-tac-service-no-match>{{ 'cyllene_digital_sylius_tarteaucitron.ui.services_no_match'|trans }}</p>
                <div class="accordion" id="tarteaucitron-services-accordion">
                    {% for section in service_sections %}
                        {% set category = section.category %}
                        {% set collapse_id = 'tac-services-' ~ category %}
                        {% set is_open = section.open %}
                        <div class="accordion-item" data-tac-service-category>
                            <h2 class="accordion-header" id="heading-{{ category }}">
                                <button
                                    class="accordion-button{% if not is_open %} collapsed{% endif %}"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#{{ collapse_id }}"
                                    aria-expanded="{{ is_open ? 'true' : 'false' }}"
                                    aria-controls="{{ collapse_id }}"
                                >
                                    <span data-tac-category-name>{{ ('cyllene_digital_sylius_tarteaucitron.ui.category_' ~ category)|trans }}</span>
                                    <span
                                        class="badge {{ section.enabled > 0 ? 'text-bg-success' : 'text-bg-secondary' }}"
                                        title="{{ 'cyllene_digital_sylius_tarteaucitron.ui.services_enabled_count'|trans }}"
                                        data-tac-category-count
                                    ><span data-tac-category-enabled>{{ section.enabled }}</span> / {{ section.services|length }}</span>
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="accordion-chevron icon icon-tabler"
                                        width="20"
                                        height="20"
                                        viewBox="0 0 24 24"
                                        stroke-width="2"
                                        stroke="currentColor"
                                        fill="none"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        aria-hidden="true"
                                        focusable="false"
                                    >
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                        <path d="M6 9l6 6l6 -6"/>
                                    </svg>
                                </button>
                            </h2>
                            <div
                                id="{{ collapse_id }}"
                                class="accordion-collapse collapse{% if is_open %} show{% endif %}"
                                aria-labelledby="heading-{{ category }}"
                            >
                                <div class="accordion-body">
                                    {% for service in section.services %}
                                        {% set service_entity = service.vars.value %}
                                        {% set service_type = service_entity.type|default('') %}
                                        {% set enabled = service_entity.enabled|default(false) %}
                                        {% set meta = tarteaucitron_service_admin_meta(service_type, enabled, service_entity.parameters|default({})) %}
                                        {% set has_details = meta.hint or meta.incomplete or service.children|length > 2 %}
                                        {% set open = enabled or not service.vars.valid %}
                                        {% set toggle = service.enabled.vars %}
                                        <div class="tac-service border rounded px-3 py-2 mb-2" data-tac-service{% if meta.badge %} id="tac-service-{{ service_type }}"{% endif %}>
                                            <div class="d-flex flex-wrap align-items-center column-gap-2 row-gap-1">
                                                <div class="form-check form-switch mb-0 flex-grow-1">
                                                    <input
                                                        type="checkbox"
                                                        class="form-check-input"
                                                        role="switch"
                                                        id="{{ toggle.id }}"
                                                        name="{{ toggle.full_name }}"
                                                        value="{{ toggle.value }}"
                                                        {% if toggle.checked %}checked{% endif %}
                                                        data-tac-service-toggle
                                                    >
                                                    <label class="form-check-label fw-medium" for="{{ toggle.id }}" data-tac-service-name>{{ meta.label|trans }}</label>
                                                </div>
                                                {% if meta.badge %}
                                                    <span class="badge {{ meta.badgeClass }}">{{ meta.badge|trans }}</span>
                                                {% endif %}
                                            </div>
                                            {% do service.enabled.setRendered %}
                                            {{ form_widget(service.type) }}
                                            {% if has_details %}
                                                <div class="mt-2{% if not open %} d-none{% endif %}" data-tac-service-details>
                                                    {% if meta.hint %}
                                                        <p class="form-hint mb-2">{{ meta.hint|trans }}</p>
                                                    {% endif %}
                                                    {% if meta.incomplete %}
                                                        <div class="alert alert-warning mb-2" role="alert">
                                                            {{ 'cyllene_digital_sylius_tarteaucitron.ui.service_incomplete'|trans }}
                                                        </div>
                                                    {% endif %}
                                                    {{ form_rest(service) }}
                                                </div>
                                            {% else %}
                                                {{ form_rest(service) }}
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    {# Keeps the active tab across the save redirect: the fragment rides on the form action.
       Waits for DOMContentLoaded: the admin bundle, which attaches Bootstrap's tab handlers, is
       loaded after this markup (synchronously, so before that event). #}
    document.addEventListener('DOMContentLoaded', () => {
        const root = document.getElementById('tarteaucitron-init-tabs');
        if (!root) {
            return;
        }
        const form = document.getElementById(root.dataset.formId);
        const remember = (tab) => {
            history.replaceState(null, '', '#tab-' + tab);
            if (form) {
                form.action = location.pathname + location.search + '#tab-' + tab;
            }
        };
        root.querySelectorAll('[data-bs-toggle="tab"]').forEach((button) => {
            button.addEventListener('shown.bs.tab', () => remember(button.dataset.tab));
        });
        const show = (tab) => {
            const button = tab ? root.querySelector('[data-tab="' + CSS.escape(tab) + '"]') : null;
            if (button) {
                button.click();
                remember(tab);
            }
        };
        const fromHash = () => (location.hash.startsWith('#tab-') ? location.hash.slice(5) : null);
        show(root.dataset.errorTab || fromHash());
        window.addEventListener('hashchange', () => show(fromHash()));
    });

    {# Services column: details (hint, identifiers) stay folded until the service is enabled, each
       category header counts the enabled services, and a search box filters by name. #}
    document.addEventListener('DOMContentLoaded', () => {
        const accordion = document.getElementById('tarteaucitron-services-accordion');
        if (!accordion) {
            return;
        }

        const refreshCount = (category) => {
            const enabled = category.querySelectorAll('[data-tac-service-toggle]:checked').length;
            category.querySelector('[data-tac-category-enabled]').textContent = enabled;
            const badge = category.querySelector('[data-tac-category-count]');
            badge.classList.toggle('text-bg-success', enabled > 0);
            badge.classList.toggle('text-bg-secondary', enabled === 0);
        };

        accordion.querySelectorAll('[data-tac-service-toggle]').forEach((toggle) => {
            toggle.addEventListener('change', () => {
                const service = toggle.closest('[data-tac-service]');
                const details = service.querySelector('[data-tac-service-details]');
                if (details) {
                    details.classList.toggle('d-none', !toggle.checked);
                    if (toggle.checked) {
                        details.querySelector('input:not([type=hidden]), textarea')?.focus();
                    }
                }
                refreshCount(service.closest('[data-tac-service-category]'));
            });
        });

        const search = document.querySelector('[data-tac-service-search]');
        const noMatch = document.querySelector('[data-tac-service-no-match]');
        const normalize = (text) => text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
        search?.addEventListener('input', () => {
            const query = normalize(search.value);
            let matches = 0;
            accordion.querySelectorAll('[data-tac-service-category]').forEach((category) => {
                const categoryHit = normalize(category.querySelector('[data-tac-category-name]').textContent).includes(query);
                let categoryMatches = 0;
                category.querySelectorAll('[data-tac-service]').forEach((service) => {
                    const hit = '' === query || categoryHit || normalize(service.querySelector('[data-tac-service-name]').textContent).includes(query);
                    service.classList.toggle('d-none', !hit);
                    categoryMatches += hit ? 1 : 0;
                });
                matches += categoryMatches;
                category.classList.toggle('d-none', '' !== query && 0 === categoryMatches);
                if ('' !== query && categoryMatches > 0) {
                    category.querySelector('.accordion-collapse').classList.add('show');
                    category.querySelector('.accordion-button').classList.remove('collapsed');
                }
            });
            noMatch.classList.toggle('d-none', '' === query || matches > 0);
        });
    });
</script>
